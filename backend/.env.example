# Server
PORT=5000

# Database (PostgreSQL connection string used by Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/smart_automotive_db"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Translation (Google Cloud Translation API - https://console.cloud.google.com/apis/credentials)
GOOGLE_TRANSLATE_API_KEY=""

# Live station camera (Phase F proof of concept) — OPTIONAL.
# The real, authorized upstream URL for the one demonstration gas
# station's live camera (an HLS .m3u8 playlist, or a direct MJPEG/video
# stream). This is the ONLY place it is ever configured — it is read
# server-side only (liveCamera.service.js), fetched and proxied through
# /api/providers/:id/live-camera/stream, and NEVER returned to any client,
# logged, or committed. Leave unset and the feature safely reports every
# camera-enabled provider as OFFLINE rather than fabricating LIVE.
LIVE_CAMERA_STREAM_URL=""

# AI assistant (Google Gemini - https://aistudio.google.com/apikey)
# Backend-only. Never expose this key to React or Flutter.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Web app base URL — used only to build the link inside a password-reset
# email (e.g. "${FRONTEND_URL}/reset-password?token=..."). Not needed for
# anything else; CORS itself stays permissive (see app.js).
FRONTEND_URL="http://localhost:5173"

# Password-reset email (Gmail SMTP via nodemailer) — OPTIONAL.
# GMAIL_USER: the sending Gmail address.
# GMAIL_APP_PASSWORD: a 16-character App Password from that Google
# Account's security settings (requires 2-Step Verification) — NOT the
# account's normal login password.
# Leave both unset and POST /auth/forgot-password still works exactly the
# same from the caller's point of view (same generic response either way,
# so the endpoint never reveals whether an account exists) — the reset
# token is created for real, but the email is only logged server-side
# instead of actually sent, so the flow stays testable without real
# credentials.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
