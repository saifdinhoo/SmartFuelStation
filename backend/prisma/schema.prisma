// Prisma schema for the Smart Automotive Service Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_QUEUE
  IN_SERVICE
  COMPLETED
  CANCELLED
  REJECTED
}

enum QueueStatus {
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  QUEUE_JOINED
  QUEUE_ALMOST_TURN
  SERVICE_STARTED
  SERVICE_COMPLETED
  NEW_REVIEW
  PROVIDER_REGISTERED
  PROVIDER_APPROVED
  PROVIDER_REJECTED
}

// PENDING: the provider has earned this money but the platform/provider
// settlement is not yet reconciled. SETTLED: an admin has marked it paid /
// accounted for. Deliberately no CANCELLED/VOID — Booking has no
// COMPLETED -> anything edge (see shared/bookingTransitions.js), so a
// settled-or-pending FinancialTransaction never needs to be reversed.
enum SettlementStatus {
  PENDING
  SETTLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider             Provider?
  approvedProviders    Provider[]              @relation("ProviderApprover")
  bookings             Booking[]
  reviews              Review[]
  complaints           Complaint[]
  queueEntries         QueueEntry[]
  passwordResetTokens  PasswordResetToken[]
  notifications        Notification[]
  fuelInventoryUpdates ProviderFuelInventory[] @relation("FuelInventoryUpdatedBy")
  fuelHistoryChanges   FuelInventoryHistory[]  @relation("FuelHistoryChangedBy")
  commissionUpdates    Provider[]              @relation("ProviderCommissionUpdatedBy")
  settledTransactions  FinancialTransaction[]  @relation("FinanceSettledBy")

  @@index([role])
  @@index([createdAt])
}

model Provider {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  businessName         String
  address              String
  description          String?
  isApproved           Boolean   @default(false)
  isOpen               Boolean   @default(false)
  latitude             Decimal?  @db.Decimal(9, 6)
  longitude            Decimal?  @db.Decimal(9, 6)
  estimatedWaitMinutes Int       @default(0)
  approvedAt           DateTime?
  approvedById         Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Platform commission percentage applied to this provider's COMPLETED
  // bookings — e.g. 10.00 = 10%. Defaulted to 10.00 for every existing and
  // new provider (see the Phase D migration note). Read by
  // finance.service.js at the moment a booking completes and snapshotted
  // onto the resulting FinancialTransaction — changing this value here
  // only ever affects transactions created *after* the change; every
  // existing FinancialTransaction keeps the rate it was created with.
  commissionRate             Decimal  @default(10.00) @db.Decimal(5, 2)
  commissionUpdatedAt        DateTime?
  commissionUpdatedByAdminId Int?

  user                    User                    @relation(fields: [userId], references: [id])
  approvedBy              User?                   @relation("ProviderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  commissionUpdatedByAdmin User?                  @relation("ProviderCommissionUpdatedBy", fields: [commissionUpdatedByAdminId], references: [id], onDelete: SetNull)
  services                ProviderService[]
  reviews                 Review[]
  complaints              Complaint[]
  queueEntries            QueueEntry[]
  notifications           Notification[]
  operatingHours          ProviderOperatingHour[]
  fuelInventory           ProviderFuelInventory[]
  fuelHistory             FuelInventoryHistory[]
  financialTransactions   FinancialTransaction[]

  @@index([isApproved, isOpen])
  @@index([createdAt])
  @@index([approvedById])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// The provider's normal weekly schedule — distinct from Provider.isOpen,
// which is a manual/live "open right now" toggle (see booking.service.js
// and availability.service.js for how the two are kept separate).
//
// openTime/closeTime are plain "HH:mm" 24-hour strings, not DateTime/Time
// columns — a wall-clock time of day has no date or timezone component of
// its own, and storing it as one invites exactly the kind of UTC-shift bug
// this feature exists to avoid. See availability.service.js's doc comment
// for the project's documented local-time assumption.
model ProviderOperatingHour {
  id         Int       @id @default(autoincrement())
  providerId Int
  dayOfWeek  DayOfWeek
  // Null on a closed day — a closed day has no opening interval.
  openTime   String?
  closeTime  String?
  isClosed   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
}

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerServices ProviderService[]
}

model ProviderService {
  id              Int      @id @default(autoincrement())
  providerId      Int
  categoryId      Int
  name            String
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider     Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  bookings     Booking[]
  queueEntries QueueEntry[]

  @@unique([providerId, name])
  @@index([categoryId])
  @@index([providerId, isAvailable])
}

model Booking {
  id                Int           @id @default(autoincrement())
  customerId        Int
  providerServiceId Int
  status            BookingStatus @default(PENDING)
  scheduledAt       DateTime
  notes             String?
  priceAtBooking    Decimal       @db.Decimal(10, 2)
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer            User                   @relation(fields: [customerId], references: [id])
  providerService     ProviderService        @relation(fields: [providerServiceId], references: [id])
  review              Review?
  queueEntry          QueueEntry?
  notifications       Notification[]
  financialTransaction FinancialTransaction?

  @@index([customerId, scheduledAt])
  @@index([providerServiceId, scheduledAt])
  @@index([status, scheduledAt])
}

// bookingId is nullable at the schema level for flexibility (e.g. a future
// admin-entered review with no booking on file), but the POST /reviews
// endpoint always requires a valid, completed, owned booking — see
// review.service.js. Postgres unique constraints allow multiple NULLs, so
// this still prevents two reviews from sharing the same real booking.
model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int?     @unique
  customerId Int
  providerId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer      User           @relation(fields: [customerId], references: [id])
  provider      Provider       @relation(fields: [providerId], references: [id])
  notifications Notification[]

  @@index([providerId, createdAt])
  @@index([customerId])
}

model QueueEntry {
  id                Int         @id @default(autoincrement())
  providerId        Int
  providerServiceId Int
  bookingId         Int?        @unique
  customerId        Int?
  customerName      String
  status            QueueStatus @default(WAITING)
  position          Int
  joinedAt          DateTime    @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime    @updatedAt

  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerService ProviderService @relation(fields: [providerServiceId], references: [id])
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer        User?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notifications   Notification[]

  @@unique([providerId, position])
  @@index([providerId, status])
  @@index([customerId])
}

model Complaint {
  id            Int               @id @default(autoincrement())
  submittedById Int
  providerId    Int
  subject       String
  details       String?
  severity      ComplaintSeverity @default(MEDIUM)
  status        ComplaintStatus   @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  submittedBy User     @relation(fields: [submittedById], references: [id])
  provider    Provider @relation(fields: [providerId], references: [id])

  @@index([status, severity])
  @@index([providerId, createdAt])
  @@index([submittedById])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id                  Int              @id @default(autoincrement())
  userId              Int
  type                NotificationType
  title               String
  message             String
  isRead              Boolean          @default(false)
  relatedBookingId    Int?
  relatedProviderId   Int?
  relatedReviewId     Int?
  relatedQueueEntryId Int?
  createdAt           DateTime         @default(now())

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedBooking    Booking?    @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)
  relatedProvider   Provider?   @relation(fields: [relatedProviderId], references: [id], onDelete: SetNull)
  relatedReview     Review?     @relation(fields: [relatedReviewId], references: [id], onDelete: SetNull)
  relatedQueueEntry QueueEntry? @relation(fields: [relatedQueueEntryId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Only the types this platform's region actually needs — see
// fuelInventory.service.js's FUEL_TYPE_LABELS for the one place display
// names are defined (never hardcoded a second time in a frontend).
enum FuelType {
  GASOLINE_95
  GASOLINE_98
  DIESEL
}

// A provider "sells fuel" precisely when it has at least one row here —
// there is deliberately no separate ProviderType/isFuelStation flag. A
// flag like that could drift from reality (marked as a fuel station with
// zero real inventory rows, or vice versa); presence of real inventory
// rows can't drift, because it *is* the data being displayed. See
// fuelInventory.service.js's doc comment for the full reasoning.
//
// currentLiters/capacityLiters are the source of truth for the
// customer-facing percentage — it is always computed from these, never
// stored separately (see percentageRemaining() in fuelInventory.service.js).
model ProviderFuelInventory {
  id               Int      @id @default(autoincrement())
  providerId       Int
  fuelType         FuelType
  capacityLiters   Decimal  @db.Decimal(12, 2)
  currentLiters    Decimal  @db.Decimal(12, 2)
  pricePerLiter    Decimal? @db.Decimal(10, 2)
  updatedByAdminId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider       Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  updatedByAdmin User?                  @relation("FuelInventoryUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  history        FuelInventoryHistory[]

  @@unique([providerId, fuelType])
  @@index([providerId])
}

// One row per Admin write that actually changed this inventory record —
// including the very first one, so a real chart always has a first point
// (see fuelInventory.service.js's createOrUpdate, "initial create" case).
// Never generated speculatively/backfilled with invented values.
model FuelInventoryHistory {
  id          Int      @id @default(autoincrement())
  inventoryId Int
  providerId  Int
  fuelType    FuelType

  previousLiters Decimal @db.Decimal(12, 2)
  newLiters      Decimal @db.Decimal(12, 2)

  previousCapacityLiters Decimal? @db.Decimal(12, 2)
  newCapacityLiters      Decimal? @db.Decimal(12, 2)

  previousPricePerLiter Decimal? @db.Decimal(10, 2)
  newPricePerLiter      Decimal? @db.Decimal(10, 2)

  changedByAdminId Int
  createdAt        DateTime @default(now())

  inventory      ProviderFuelInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  provider       Provider              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  changedByAdmin User                  @relation("FuelHistoryChangedBy", fields: [changedByAdminId], references: [id])

  @@index([inventoryId, createdAt])
  @@index([providerId, fuelType, createdAt])
}

// Phase D — the internal Provider <-> Admin/Platform accounting ledger.
//
// One immutable row per COMPLETED booking (see finance.service.js's
// createTransactionForCompletedBooking, called atomically from
// booking.service.js's updateBookingStatus when a booking reaches
// COMPLETED — never for any other status). Every money field is a
// snapshot taken at that moment: grossAmount comes from
// Booking.priceAtBooking (itself already immutable at booking-creation
// time) and commissionRate/commissionAmount/providerNetAmount are derived
// from Provider.commissionRate as it stood *at completion time*. A later
// change to Provider.commissionRate never rewrites any existing row here
// — see the Phase D report's "commission configuration" section.
//
// Finance begins from the migration that introduced this table forward
// only. Bookings that were already COMPLETED before this feature existed
// have no historical commissionRate to snapshot honestly, so no row is
// backfilled for them — see the Phase D report's "existing-booking
// strategy" section for the full reasoning.
model FinancialTransaction {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  providerId Int

  grossAmount       Decimal @db.Decimal(10, 2)
  commissionRate    Decimal @db.Decimal(5, 2)
  commissionAmount  Decimal @db.Decimal(10, 2)
  providerNetAmount Decimal @db.Decimal(10, 2)

  settlementStatus SettlementStatus @default(PENDING)
  settledAt        DateTime?
  settledByAdminId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking        Booking  @relation(fields: [bookingId], references: [id])
  provider       Provider @relation(fields: [providerId], references: [id])
  settledByAdmin User?    @relation("FinanceSettledBy", fields: [settledByAdminId], references: [id], onDelete: SetNull)

  @@index([providerId, settlementStatus])
  @@index([providerId, createdAt])
  @@index([settlementStatus])
}
