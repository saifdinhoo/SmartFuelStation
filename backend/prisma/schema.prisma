// Prisma schema for the Smart Automotive Service Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider            Provider?
  approvedProviders   Provider[]           @relation("ProviderApprover")
  bookings            Booking[]
  reviews             Review[]
  complaints          Complaint[]
  queueEntries        QueueEntry[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([createdAt])
}

model Provider {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  businessName         String
  address              String
  description          String?
  isApproved           Boolean   @default(false)
  isOpen               Boolean   @default(false)
  latitude             Decimal?  @db.Decimal(9, 6)
  longitude            Decimal?  @db.Decimal(9, 6)
  estimatedWaitMinutes Int       @default(0)
  approvedAt           DateTime?
  approvedById         Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id])
  approvedBy   User?             @relation("ProviderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  services     ProviderService[]
  reviews      Review[]
  complaints   Complaint[]
  queueEntries QueueEntry[]

  @@index([isApproved, isOpen])
  @@index([createdAt])
  @@index([approvedById])
}

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerServices ProviderService[]
}

model ProviderService {
  id              Int      @id @default(autoincrement())
  providerId      Int
  categoryId      Int
  name            String
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider     Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  bookings     Booking[]
  queueEntries QueueEntry[]

  @@unique([providerId, name])
  @@index([categoryId])
  @@index([providerId, isAvailable])
}

model Booking {
  id                Int           @id @default(autoincrement())
  customerId        Int
  providerServiceId Int
  status            BookingStatus @default(PENDING)
  scheduledAt       DateTime
  notes             String?
  priceAtBooking    Decimal       @db.Decimal(10, 2)
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer        User            @relation(fields: [customerId], references: [id])
  providerService ProviderService @relation(fields: [providerServiceId], references: [id])
  review          Review?
  queueEntry      QueueEntry?

  @@index([customerId, scheduledAt])
  @@index([providerServiceId, scheduledAt])
  @@index([status, scheduledAt])
}

model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  customerId Int
  providerId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, createdAt])
  @@index([customerId])
}

model QueueEntry {
  id                Int         @id @default(autoincrement())
  providerId        Int
  providerServiceId Int
  bookingId         Int?        @unique
  customerId        Int?
  customerName      String
  status            QueueStatus @default(WAITING)
  position          Int
  joinedAt          DateTime    @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime    @updatedAt

  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerService ProviderService @relation(fields: [providerServiceId], references: [id])
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer        User?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([providerId, position])
  @@index([providerId, status])
  @@index([customerId])
}

model Complaint {
  id            Int               @id @default(autoincrement())
  submittedById Int
  providerId    Int
  subject       String
  details       String?
  severity      ComplaintSeverity @default(MEDIUM)
  status        ComplaintStatus   @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  submittedBy User     @relation(fields: [submittedById], references: [id])
  provider    Provider @relation(fields: [providerId], references: [id])

  @@index([status, severity])
  @@index([providerId, createdAt])
  @@index([submittedById])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
